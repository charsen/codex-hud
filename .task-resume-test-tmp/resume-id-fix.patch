+export async function waitForRootSessionById(
+  cwd: string,
+  sessionId: string,
+  codexHome = getCodexHome(),
+  signal?: AbortSignal,
+): Promise<string | null> {
+  while (true) {
+    if (signal?.aborted) {
+      return null
+    }
+    const session = findRootSessionById(cwd, sessionId, codexHome)
+    if (session) {
+      return session.path
+    }
+    await delay(250, signal)
+  }
